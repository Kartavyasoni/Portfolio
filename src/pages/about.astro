---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import GlowCard from '@/components/ui/GlowCard.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SkillsSection from '@/components/sections/about/SkillsSection.astro';
import ExperienceTimeline from '@/components/sections/about/ExperienceTimeline.astro';
import { certifications } from '@/data/certifications';
import { site } from '@/lib/site';

const philosophy = [
  {
    title: 'Start from the decision',
    body: 'Before a single feature, I ask what decision this model changes and who acts on it. That framing sets the target, the metric, and the threshold.',
  },
  {
    title: 'Distrust a great score',
    body: 'Most impressive offline results are leakage. Out-of-time validation, fold-scoped preprocessing, and dropping post-outcome fields come before celebrating a number.',
  },
  {
    title: 'Explain, then deploy',
    body: 'If a reviewer or auditor can’t follow why a prediction was made, it isn’t finished. SHAP, calibration, and human-in-the-loop review are part of the build.',
  },
];
---

<Layout
  title="About"
  description="The story, education, philosophy, skills, and experience behind a data scientist working in insurance and financial services."
>
  <PageHero
    kicker="About Me"
    title="From raw data to real-world impact"
    intro="I’m a Data Scientist with 3 years of experience in insurance and financial services — building predictive models, Generative AI solutions, and responsible ML systems that improve real operational decisions."
  >
    <div class="mt-8 flex flex-wrap gap-3" data-hero-item>
      <Button href="/projects" icon="arrowRight">See the work</Button>
      <Button href="/contact" variant="secondary">Get in touch</Button>
    </div>
  </PageHero>

  <!-- Story + Education -->
  <Section container="default">
    <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div data-reveal class="flex flex-col gap-5 text-base leading-relaxed text-muted">
        {/* A real heading, not a styled span — otherwise the education card's
            h3 below skips straight from the page h1. */}
        <h2 class="kicker font-normal">The Story</h2>
        <p>
          I got into data science through problems where being wrong is
          expensive. Fraud alerts that waste an investigator’s week. A claim
          routed to the wrong adjuster. A loan denial nobody can explain. In
          those settings a model isn’t a leaderboard entry — it’s someone’s
          workflow, and sometimes someone’s outcome.
        </p>
        <p>
          Over three years across <span class="text-text">insurance and financial services</span>,
          that shaped how I work. At Mphasis I built transaction-monitoring and
          fraud models over card payments, lifting confirmed-fraud recall by 16%
          while cutting false-positive alerts by 13%. At Allstate I work on
          claims routing at roughly 150K claims a month, plus Generative AI
          tooling that helps adjusters find the guidance they need faster.
        </p>
        <p>
          The thread through all of it is <span class="text-text">evaluation I can defend</span> —
          leakage-free validation, SHAP explanations, calibration, and
          human-in-the-loop review — paired with a Computer Science Master’s
          that keeps me honest about the engineering underneath.
        </p>
      </div>

      <div data-reveal>
        <GlowCard class="h-full">
          <Badge variant="accent">Education</Badge>
          <h3 class="mt-4 text-xl font-semibold">M.S. Computer Science</h3>
          <p class="mt-1 text-sm text-muted">
            Florida Atlantic University · USA
          </p>
          <p class="mt-4 text-sm leading-relaxed text-muted">
            Graduated May 2026 with a 3.96 GPA, focused on machine learning,
            applied statistics, and data systems — backed by a B.E. in Computer
            Engineering (GPA 3.70).
          </p>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-border pt-6">
            <div>
              <dt class="font-mono text-xs text-faint">GPA</dt>
              <dd class="mt-1 text-sm text-text">3.96 / 4.0</dd>
            </div>
            <div>
              <dt class="font-mono text-xs text-faint">Based in</dt>
              <dd class="mt-1 text-sm text-text">{site.location}</dd>
            </div>
          </dl>
        </GlowCard>
      </div>
    </div>
  </Section>

  <!-- Technical philosophy -->
  <Section
    kicker="How I Work"
    title="Technical philosophy"
    intro="A few principles that shape how I build."
  >
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        philosophy.map((p, i) => (
          <div data-reveal>
            <GlowCard class="h-full">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
            </GlowCard>
          </div>
        ))
      }
    </div>
  </Section>

  <SkillsSection />

  <ExperienceTimeline />

  <!-- Certifications -->
  <Section
    kicker="Credentials"
    title="Certifications"
    intro="Continued learning, verified."
  >
    <!-- Two certs: a 2-col grid fills the row instead of leaving empty cells. -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        certifications.map((cert) => (
          <div data-reveal>
            <GlowCard
              href={cert.credentialUrl}
              class="h-full"
            >
              <div class="flex items-start justify-between">
                <span class="grid size-10 place-items-center rounded-lg border border-accent/30 bg-accent/10 font-mono text-xs text-accent">
                  {cert.year}
                </span>
                {cert.credentialUrl && (
                  <Icon name="external" class="size-4 text-faint" />
                )}
              </div>
              <h3 class="mt-4 text-base font-semibold leading-snug">{cert.name}</h3>
              <p class="mt-1 text-sm text-muted">{cert.issuer}</p>
            </GlowCard>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section container="narrow">
    <div data-reveal>
      <GlowCard class="text-center" noLift>
        <h2 class="text-2xl font-semibold sm:text-3xl">Let’s build something with data</h2>
        <p class="mx-auto mt-3 max-w-lg text-muted">
          I’m targeting Data Scientist roles where I can build practical machine
          learning and Generative AI solutions that improve operational decisions.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button href="/contact" size="lg" icon="arrowRight">Get in touch</Button>
          <Button href="/projects" variant="secondary" size="lg">View projects</Button>
        </div>
      </GlowCard>
    </div>
  </Section>
</Layout>
