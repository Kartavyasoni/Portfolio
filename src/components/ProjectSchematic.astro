---
/**
 * Per-project architecture sketch shown in the card preview.
 * Diagram markup lives in @/lib/project-diagrams so the React gallery island
 * renders exactly the same picture.
 */
import { getProjectDiagram } from '@/lib/project-diagrams';

interface Props {
  /** Project slug — falls back to a generic pipeline for unknown ids. */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 400 180"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={getProjectDiagram(id)}
/>
