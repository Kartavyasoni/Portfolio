---
import Section from '@/components/ui/Section.astro';
import GlowCard from '@/components/ui/GlowCard.astro';
import { skillGroups } from '@/data/skills';
---

<Section
  id="skills"
  kicker="Toolkit"
  title="Skills, grouped by craft"
  intro="The tools I actually reach for, organised by where they sit in the work — from wrangling raw data to shipping and monitoring a model."
>
  <div class="mt-14 grid gap-5 lg:grid-cols-2">
    {
      skillGroups.map((group) => (
        <div data-reveal>
          <GlowCard class="h-full" accentHover>
            <h3 class="text-lg font-semibold">{group.title}</h3>
            <p class="mt-1 text-sm text-muted">{group.caption}</p>
            {/* Captions are all one line here, so chips read better flowing
                straight on rather than pinned to the card's bottom edge. */}
            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`${group.title} skills`}>
              {group.skills.map((skill) => (
                <li class="rounded-md bg-surface-3 px-2 py-1 font-mono text-[11px] text-faint">
                  {skill}
                </li>
              ))}
            </ul>
          </GlowCard>
        </div>
      ))
    }
  </div>
</Section>
